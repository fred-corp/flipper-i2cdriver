App(
    appid="i2cdriver",
    name="I2CDriver Bridge",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="i2cdriver_app",
    cdefines=["APP_I2CDRIVER"],
    requires=[
        "gui",
        "i2c",
    ],
    stack_size=4 * 1024,
    order=176,
